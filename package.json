{
  "name": "gespan-desktop",
  "description": "A desktop GUI for your coding agents",
  "license": "MIT",
  "author": "vasanth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xvasanth/gespan.git"
  },
  "bugs": {
    "url": "https://github.com/0xvasanth/gespan/issues"
  },
  "homepage": "https://gespan.dev",
  "private": true,
  "packageManager": "bun@1.3.14",
  "version": "0.0.1-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --mode stable",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "host:build": "tsc --noEmit -p host/tsconfig.json && node host/build.mjs",
    "host:package": "bun run host:build && node host/package.mjs",
    "host": "node build/host/gespan-host.mjs",
    "pretest:host": "bun run host:build",
    "test:host": "vitest run --config host/vitest.config.ts",
    "check": "bun run check:web && bun run check:rust",
    "check:web": "vitest run && tsc --noEmit",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test",
    "set-version": "node scripts/bump-version.mjs",
    "tauri": "tauri",
    "tauri:stable": "tauri dev --no-watch --config src-tauri/tauri.stable.conf.json",
    "setup:linux:deb": "bash scripts/install-linux-deps-debian.sh",
    "setup:linux:fedora": "bash scripts/install-linux-deps-fedora.sh",
    "build:linux": "tauri build --bundles deb,appimage && bash scripts/repack-appimage.sh",
    "build:fedora": "tauri build --bundles rpm",
    "build:windows": "RUSTUP_TOOLCHAIN=stable-x86_64-pc-windows-msvc tauri build --bundles nsis",
    "native:dev": "node scripts/dev-native.mjs",
    "native:test:dev": "node --test scripts/dev-native.test.mjs scripts/bundle-native-macos.test.mjs scripts/native-dependencies.test.mjs scripts/native-release.test.mjs scripts/package-native.test.mjs",
    "native:build": "node scripts/build-native.mjs",
    "native:test": "cargo test --locked -p gespan-tracker-client && cargo test --locked -p gespan-board-store && cargo test --locked --manifest-path crates/gespan-gpui/Cargo.toml -p gespan-core --profile native-dev && cargo test --locked --manifest-path crates/gespan-gpui/Cargo.toml -p gespan-gpui --profile native-dev -- --test-threads=1",
    "native:check": "bun run native:test:dev && cargo fmt --manifest-path crates/gespan-gpui/Cargo.toml --all --check && cargo clippy --locked --manifest-path crates/gespan-gpui/Cargo.toml -p gespan-core -p gespan-gpui --all-targets --profile native-dev -- -D warnings && bun run native:test"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@streamdown/code": "^2.0.0",
    "@streamdown/mermaid": "^1.0.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "cuelume": "^0.2.8",
    "emojibase-data": "^18.0.0",
    "frimousse": "^0.4.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-material-icon-theme": "^1.2.0",
    "rehype-harden": "^1.1.8",
    "remend": "^1.4.0",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
