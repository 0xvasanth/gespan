{
  "type": "doc",
  "version": 1,
  "content": [
    {
      "type": "heading",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "type": "text",
          "text": "Board filters"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "As a lead I want to filter the board so that "
        },
        {
          "type": "text",
          "text": "only my team's",
          "marks": [
            {
              "type": "strong"
            },
            {
              "type": "em"
            }
          ]
        },
        {
          "type": "text",
          "text": " cards show."
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Filter by:"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "label"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "assignee"
                        }
                      ]
                    },
                    {
                      "type": "orderedList",
                      "attrs": {
                        "order": 3
                      },
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "me"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "anyone on "
                                },
                                {
                                  "type": "text",
                                  "text": "@team",
                                  "marks": [
                                    {
                                      "type": "code"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Saved views, see "
                },
                {
                  "type": "text",
                  "text": "PLAT-88",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://x.atlassian.net/browse/PLAT-88",
                        "title": "Saved views epic"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "From the design review: "
            },
            {
              "type": "text",
              "text": "keep it simple",
              "marks": [
                {
                  "type": "em"
                }
              ]
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "no nested groups"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Out of scope: "
        },
        {
          "type": "text",
          "text": "*wildcards*",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "type": "text",
          "text": ", regex, and [brackets] in names."
        }
      ]
    },
    {
      "type": "codeBlock",
      "content": [
        {
          "type": "text",
          "text": "status = \"In Review\" AND labels in (agent)"
        }
      ]
    }
  ]
